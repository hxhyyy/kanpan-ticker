{
  "name": "kanpan-ticker",
  "displayName": "Kanpan Ticker (码上看盘)",
  "description": "Real-time US stocks, A-shares & crypto ticker in VS Code / Cursor status bar and sidebar. 美股/A股/加密货币实时行情，状态栏+侧边栏看盘。",
  "version": "0.8.0",
  "publisher": "your-name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hxhyyy/kanpan-ticker.git"
  },
  "bugs": {
    "url": "https://github.com/hxhyyy/kanpan-ticker/issues"
  },
  "homepage": "https://github.com/hxhyyy/kanpan-ticker#readme",
  "keywords": [
    "vscode",
    "vscode-extension",
    "cursor",
    "stock",
    "stock-ticker",
    "ticker",
    "crypto",
    "bitcoin",
    "binance",
    "a-share",
    "china-stock",
    "us-stock",
    "market",
    "finance",
    "status-bar",
    "sidebar",
    "real-time",
    "leekfund",
    "看盘",
    "码上看盘",
    "kanpan"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:kanpanView.stock",
    "onView:kanpanView.crypto",
    "onView:kanpanView.reader",
    "onView:kanpanView.readerText",
    "onView:kanpanView.settings"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "kanpan.rise",
        "description": "看盘插件上涨颜色",
        "defaults": {
          "dark": "#089981",
          "light": "#089981"
        }
      },
      {
        "id": "kanpan.fall",
        "description": "看盘插件下跌颜色",
        "defaults": {
          "dark": "#ef5350",
          "light": "#ef5350"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kanpanMenu",
          "title": "Kanpan Ticker",
          "icon": "resources/kanpan.svg"
        }
      ]
    },
    "views": {
      "kanpanMenu": [
        {
          "id": "kanpanView.stock",
          "name": "Stock"
        },
        {
          "id": "kanpanView.crypto",
          "name": "Crypto"
        },
        {
          "id": "kanpanView.reader",
          "name": "Reader"
        },
        {
          "id": "kanpanView.readerText",
          "name": "正文",
          "type": "webview"
        },
        {
          "id": "kanpanView.settings",
          "name": "Settings"
        }
      ]
    },
    "commands": [
      {
        "command": "kanpan.refresh",
        "title": "看盘插件: 立即刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "kanpan.show",
        "title": "看盘插件: 显示状态栏"
      },
      {
        "command": "kanpan.hide",
        "title": "看盘插件: 隐藏状态栏"
      },
      {
        "command": "kanpan.peekStatusBar",
        "title": "看盘插件: 点亮底部行情"
      },
      {
        "command": "kanpan.toggleStatusBarDisplayMode",
        "title": "看盘插件: 切换常亮/点按"
      },
      {
        "command": "kanpan.togglePriceAlertsMute",
        "title": "看盘插件: 开关价格提醒"
      },
      {
        "command": "kanpan.addStock",
        "title": "看盘插件: 添加美股",
        "icon": "$(add)"
      },
      {
        "command": "kanpan.addAShare",
        "title": "看盘插件: 添加 A 股",
        "icon": "$(add)"
      },
      {
        "command": "kanpan.addCrypto",
        "title": "看盘插件: 添加加密货币",
        "icon": "$(add)"
      },
      {
        "command": "kanpan.removeStock",
        "title": "删除美股",
        "icon": "$(trash)"
      },
      {
        "command": "kanpan.removeAShare",
        "title": "删除 A 股",
        "icon": "$(trash)"
      },
      {
        "command": "kanpan.removeCrypto",
        "title": "删除加密货币",
        "icon": "$(trash)"
      },
      {
        "command": "kanpan.selectStockSource",
        "title": "看盘插件: 切换美股数据源",
        "icon": "$(server-environment)"
      },
      {
        "command": "kanpan.selectColorScheme",
        "title": "看盘插件: 涨跌颜色方案",
        "icon": "$(symbol-color)"
      },
      {
        "command": "kanpan.setRiseColor",
        "title": "设置上涨颜色",
        "icon": "$(arrow-up)"
      },
      {
        "command": "kanpan.setFallColor",
        "title": "设置下跌颜色",
        "icon": "$(arrow-down)"
      },
      {
        "command": "kanpan.setStatusBarBrightness",
        "title": "看盘插件: 底部字体深浅",
        "icon": "$(eye)"
      },
      {
        "command": "kanpan.moveUp",
        "title": "上移",
        "icon": "$(chevron-up)"
      },
      {
        "command": "kanpan.moveDown",
        "title": "下移",
        "icon": "$(chevron-down)"
      },
      {
        "command": "kanpan.addToStatusBar",
        "title": "添加到状态栏",
        "icon": "$(pin)"
      },
      {
        "command": "kanpan.removeFromStatusBar",
        "title": "从状态栏移除",
        "icon": "$(pinned-dirty)"
      },
      {
        "command": "kanpan.setPriceAlert",
        "title": "设置价格提醒",
        "icon": "$(bell)"
      },
      {
        "command": "kanpan.managePriceAlerts",
        "title": "管理价格提醒",
        "icon": "$(bell-dot)"
      },
      {
        "command": "kanpan.deletePriceAlert",
        "title": "删除价格提醒",
        "icon": "$(trash)"
      },
      {
        "command": "kanpan.managePriceAlertItem",
        "title": "管理单条价格提醒"
      },
      {
        "command": "kanpan.openSettings",
        "title": "打开设置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kanpan.readerOpen",
        "title": "看盘插件: 打开 EPUB",
        "icon": "$(book)"
      },
      {
        "command": "kanpan.readerNext",
        "title": "看盘插件: 阅读下一句",
        "icon": "$(chevron-right)"
      },
      {
        "command": "kanpan.readerPrev",
        "title": "看盘插件: 阅读上一句",
        "icon": "$(chevron-left)"
      },
      {
        "command": "kanpan.readerJumpChapter",
        "title": "跳转章节"
      },
      {
        "command": "kanpan.readerClose",
        "title": "看盘插件: 关闭当前书"
      }
    ],
    "keybindings": [
      {
        "command": "kanpan.readerNext",
        "key": "right",
        "mac": "right",
        "when": "kanpan.readerActive && !suggestWidgetVisible && !renameInputVisible && !findWidgetVisible && !inQuickOpen"
      },
      {
        "command": "kanpan.readerPrev",
        "key": "left",
        "mac": "left",
        "when": "kanpan.readerActive && !suggestWidgetVisible && !renameInputVisible && !findWidgetVisible && !inQuickOpen"
      },
      {
        "command": "kanpan.readerNext",
        "key": "alt+]",
        "mac": "alt+]",
        "when": "kanpan.readerActive"
      },
      {
        "command": "kanpan.readerPrev",
        "key": "alt+[",
        "mac": "alt+[",
        "when": "kanpan.readerActive"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kanpan.refresh",
          "when": "view == kanpanView.stock || view == kanpanView.crypto",
          "group": "navigation"
        },
        {
          "command": "kanpan.addCrypto",
          "when": "view == kanpanView.crypto",
          "group": "navigation"
        },
        {
          "command": "kanpan.selectStockSource",
          "when": "view == kanpanView.stock || view == kanpanView.settings",
          "group": "navigation"
        },
        {
          "command": "kanpan.readerOpen",
          "when": "view == kanpanView.reader",
          "group": "navigation"
        },
        {
          "command": "kanpan.readerPrev",
          "when": "view == kanpanView.reader",
          "group": "navigation"
        },
        {
          "command": "kanpan.readerNext",
          "when": "view == kanpanView.reader",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kanpan.addStock",
          "when": "view == kanpanView.stock && viewItem == stockGroup",
          "group": "inline"
        },
        {
          "command": "kanpan.addAShare",
          "when": "view == kanpanView.stock && viewItem == aStockGroup",
          "group": "inline"
        },
        {
          "command": "kanpan.addToStatusBar",
          "when": "view == kanpanView.stock && (viewItem == usStock || viewItem == usStockAlert)",
          "group": "status@1"
        },
        {
          "command": "kanpan.removeFromStatusBar",
          "when": "view == kanpanView.stock && (viewItem == usStockPinned || viewItem == usStockPinnedAlert)",
          "group": "status@1"
        },
        {
          "command": "kanpan.setPriceAlert",
          "when": "view == kanpanView.stock && (viewItem == usStock || viewItem == usStockPinned || viewItem == usStockAlert || viewItem == usStockPinnedAlert)",
          "group": "inline@0"
        },
        {
          "command": "kanpan.managePriceAlerts",
          "when": "view == kanpanView.stock && (viewItem == usStock || viewItem == usStockPinned || viewItem == usStockAlert || viewItem == usStockPinnedAlert)",
          "group": "alert@2"
        },
        {
          "command": "kanpan.addToStatusBar",
          "when": "view == kanpanView.stock && (viewItem == aStock || viewItem == aStockAlert)",
          "group": "status@1"
        },
        {
          "command": "kanpan.removeFromStatusBar",
          "when": "view == kanpanView.stock && (viewItem == aStockPinned || viewItem == aStockPinnedAlert)",
          "group": "status@1"
        },
        {
          "command": "kanpan.setPriceAlert",
          "when": "view == kanpanView.stock && (viewItem == aStock || viewItem == aStockPinned || viewItem == aStockAlert || viewItem == aStockPinnedAlert)",
          "group": "inline@0"
        },
        {
          "command": "kanpan.managePriceAlerts",
          "when": "view == kanpanView.stock && (viewItem == aStock || viewItem == aStockPinned || viewItem == aStockAlert || viewItem == aStockPinnedAlert)",
          "group": "alert@2"
        },
        {
          "command": "kanpan.moveUp",
          "when": "view == kanpanView.stock && (viewItem == usStock || viewItem == usStockPinned || viewItem == aStock || viewItem == aStockPinned || viewItem == usStockAlert || viewItem == usStockPinnedAlert || viewItem == aStockAlert || viewItem == aStockPinnedAlert)",
          "group": "inline@1"
        },
        {
          "command": "kanpan.moveDown",
          "when": "view == kanpanView.stock && (viewItem == usStock || viewItem == usStockPinned || viewItem == aStock || viewItem == aStockPinned || viewItem == usStockAlert || viewItem == usStockPinnedAlert || viewItem == aStockAlert || viewItem == aStockPinnedAlert)",
          "group": "inline@1"
        },
        {
          "command": "kanpan.removeAShare",
          "when": "view == kanpanView.stock && (viewItem == aStock || viewItem == aStockPinned || viewItem == aStockAlert || viewItem == aStockPinnedAlert)",
          "group": "inline@2"
        },
        {
          "command": "kanpan.addToStatusBar",
          "when": "view == kanpanView.crypto && (viewItem == crypto || viewItem == cryptoAlert)",
          "group": "status@1"
        },
        {
          "command": "kanpan.removeFromStatusBar",
          "when": "view == kanpanView.crypto && (viewItem == cryptoPinned || viewItem == cryptoPinnedAlert)",
          "group": "status@1"
        },
        {
          "command": "kanpan.setPriceAlert",
          "when": "view == kanpanView.crypto && (viewItem == crypto || viewItem == cryptoPinned || viewItem == cryptoAlert || viewItem == cryptoPinnedAlert)",
          "group": "inline@0"
        },
        {
          "command": "kanpan.managePriceAlerts",
          "when": "view == kanpanView.crypto && (viewItem == crypto || viewItem == cryptoPinned || viewItem == cryptoAlert || viewItem == cryptoPinnedAlert)",
          "group": "alert@2"
        },
        {
          "command": "kanpan.moveUp",
          "when": "view == kanpanView.crypto && (viewItem == crypto || viewItem == cryptoPinned || viewItem == cryptoAlert || viewItem == cryptoPinnedAlert)",
          "group": "inline@1"
        },
        {
          "command": "kanpan.moveDown",
          "when": "view == kanpanView.crypto && (viewItem == crypto || viewItem == cryptoPinned || viewItem == cryptoAlert || viewItem == cryptoPinnedAlert)",
          "group": "inline@1"
        },
        {
          "command": "kanpan.removeStock",
          "when": "view == kanpanView.stock && (viewItem == usStock || viewItem == usStockPinned || viewItem == usStockAlert || viewItem == usStockPinnedAlert)",
          "group": "inline@2"
        },
        {
          "command": "kanpan.removeCrypto",
          "when": "view == kanpanView.crypto && (viewItem == crypto || viewItem == cryptoPinned || viewItem == cryptoAlert || viewItem == cryptoPinnedAlert)",
          "group": "inline@2"
        },
        {
          "command": "kanpan.deletePriceAlert",
          "when": "viewItem == priceAlert",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Kanpan Ticker",
      "properties": {
        "kanpan.stocks": {
          "type": "array",
          "default": [
            "AAPL",
            "NVDA",
            "TSLA"
          ],
          "description": "要监控的美股代码"
        },
        "kanpan.aShares": {
          "type": "array",
          "default": [
            "sh600519",
            "sz300750"
          ],
          "description": "要监控的 A 股代码，如 sh600519、600519；添加时也可输入中文名称搜索"
        },
        "kanpan.stockDataSource": {
          "type": "string",
          "enum": [
            "auto",
            "eastmoney",
            "sina",
            "tencent",
            "finnhubExtended",
            "finnhub"
          ],
          "enumDescriptions": [
            "按优先级自动回退",
            "东方财富（免 Key，盘前盘后）",
            "新浪财经（免 Key，LeekFund 同款）",
            "腾讯财经（免 Key）",
            "Finnhub 盘前盘后（需 Key）",
            "Finnhub 盘中（需 Key）"
          ],
          "default": "auto",
          "description": "美股行情数据源"
        },
        "kanpan.autoFallbackOrder": {
          "type": "array",
          "default": [
            "eastmoney",
            "sina",
            "tencent",
            "finnhubExtended",
            "finnhub"
          ],
          "description": "自动模式下的数据源优先级"
        },
        "kanpan.cryptoSymbols": {
          "type": "array",
          "default": [
            "BTCUSDT"
          ],
          "description": "Binance 交易对，如 BTCUSDT、ETHUSDT"
        },
        "kanpan.statusBarItems": {
          "type": "array",
          "default": [],
          "description": "显示在底部状态栏的标的，格式 stock:AAPL、ashare:sh600519 或 crypto:BTCUSDT"
        },
        "kanpan.finnhubApiKey": {
          "type": "string",
          "default": "",
          "description": "Finnhub API Key（使用 Finnhub 数据源时需要，https://finnhub.io）"
        },
        "kanpan.stockRefreshInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 1000,
          "description": "美股和 A 股刷新间隔（毫秒，默认 2000 即每 2 秒）"
        },
        "kanpan.cryptoRefreshInterval": {
          "type": "number",
          "default": 1000,
          "minimum": 1000,
          "description": "加密货币刷新间隔（毫秒，默认 1000 即每 1 秒）"
        },
        "kanpan.colorScheme": {
          "type": "string",
          "enum": [
            "us",
            "cn",
            "custom",
            "none"
          ],
          "enumDescriptions": [
            "美国惯例：绿涨红跌",
            "中国惯例：红涨绿跌",
            "自定义涨跌颜色",
            "无颜色：涨跌不显示颜色，使用默认字体"
          ],
          "default": "us",
          "description": "涨跌颜色方案"
        },
        "kanpan.riseColor": {
          "type": "string",
          "default": "#089981",
          "description": "上涨颜色（colorScheme 为 custom 时生效）"
        },
        "kanpan.fallColor": {
          "type": "string",
          "default": "#ef5350",
          "description": "下跌颜色（colorScheme 为 custom 时生效）"
        },
        "kanpan.showChangePercent": {
          "type": "boolean",
          "default": true,
          "description": "显示涨跌幅"
        },
        "kanpan.monochrome": {
          "type": "boolean",
          "default": false,
          "description": "隐身模式：隐藏涨跌颜色和箭头"
        },
        "kanpan.format": {
          "type": "string",
          "default": "{symbol} {price} {change} {icon}",
          "description": "状态栏格式，占位符: {symbol} {price} {change} {volume} {icon}"
        },
        "kanpan.showVolume": {
          "type": "boolean",
          "default": true,
          "description": "保留配置项（当前版本成交量仅在悬浮详情中显示）"
        },
        "kanpan.aliases": {
          "type": "object",
          "default": {},
          "description": "别名映射，如 {\"BTCUSDT\": \"BTC\"}"
        },
        "kanpan.onlyRefreshWhenFocused": {
          "type": "boolean",
          "default": false,
          "description": "仅在窗口聚焦时刷新"
        },
        "kanpan.alertCooldownMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "价格提醒「每次触发」的默认冷却分钟数；创建提醒时可单独覆盖。0 表示不冷却"
        },
        "kanpan.alertNotifyMode": {
          "type": "string",
          "enum": [
            "system",
            "ide",
            "both"
          ],
          "enumDescriptions": [
            "Windows 系统通知中心（隐蔽，默认）",
            "仅 Cursor/VS Code 编辑器内角标",
            "系统通知 + 编辑器角标同时弹出"
          ],
          "default": "system",
          "description": "价格提醒的通知方式。文案仅为现价数字。默认仅系统通知，不弹编辑器角标"
        },
        "kanpan.statusBarStealth": {
          "type": "boolean",
          "default": true,
          "description": "（已由底部图钉按钮取代）兼容旧配置：true=点按点亮，false=常亮"
        },
        "kanpan.statusBarPeekSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "点按点亮模式下，点亮后保持显示的秒数（之后约 1 秒淡出）"
        },
        "kanpan.statusBarBrightness": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 100,
          "description": "底部状态栏行情文字深浅（10 最暗，100 最亮）。侧边栏设置也可快捷选择，档位对齐点亮淡出梯度"
        },
        "kanpan.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用状态栏显示"
        },
        "kanpan.statusBarPosition": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "显示在状态栏左侧（更醒目）",
            "显示在状态栏右侧"
          ],
          "default": "left",
          "description": "状态栏显示位置"
        },
        "kanpan.readerDefaultEpub": {
          "type": "string",
          "default": "",
          "description": "默认 EPUB 路径；首次打开且尚未选书时可自动加载"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.11.0",
    "@types/node-notifier": "^8.0.5",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.3"
  }
}
